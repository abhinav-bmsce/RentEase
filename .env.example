# Firebase Configuration (From Firebase Console > Project Settings > Web App)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=rentease-3f04f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rentease-3f04f
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Owner UPI VPA (Default receiving address for QR codes; can also be changed in Admin Settings)
VITE_DEFAULT_UPI_ID=owner@upi
