rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin' && getUserData().active == true;
    }

    function isTenant() {
      return isAuthenticated() && getUserData().role == 'tenant' && getUserData().active == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isFirstTimeSetup() {
      return !exists(/databases/$(database)/documents/settings/general);
    }

    // ─── Users Collection ───────────────────────────────────────────
    match /users/{userId} {
      // Admin has full control
      allow read, write: if isAdmin();
      // Tenant can read their own document
      allow read: if isOwner(userId);
      // One-time initial admin creation if the system is not yet initialized
      allow create: if isOwner(userId)
                    && isFirstTimeSetup()
                    && request.resource.data.role == 'admin'
                    && request.resource.data.active == true
                    && request.resource.data.mustChangePassword == false
                    && getAfter(/databases/$(database)/documents/settings/general).data.bootstrapUid == request.auth.uid;
      // Tenant can only update mustChangePassword and updatedAt on their own doc
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
                    && request.resource.data.mustChangePassword == false;
    }

    // ─── Properties Collection ──────────────────────────────────────
    match /properties/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Rooms Collection ───────────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Tenancies Collection ───────────────────────────────────────
    match /tenancies/{tenancyId} {
      allow read: if isAdmin() || (isTenant() && resource.data.tenantUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ─── Bills Collection ───────────────────────────────────────────
    match /bills/{billId} {
      allow read: if isAdmin() || (isTenant() && resource.data.tenantUid == request.auth.uid);
      allow create, delete: if isAdmin();
      // Admin can update anything; tenant can only transition to 'submitted' upon payment submission
      // Tenants cannot alter amounts, line items, roomId, month, paidAmount, or dueDate
      allow update: if isAdmin()
                    || (isTenant()
                        && resource.data.tenantUid == request.auth.uid
                        && (resource.data.status == 'unpaid' || resource.data.status == 'overdue')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                        && request.resource.data.status == 'submitted');
    }

    // ─── Payments Collection ────────────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isTenant() && resource.data.tenantUid == request.auth.uid);
      // Tenant can only submit payments in 'pending' status for their own account
      // Validates ownership, positive amount, valid UTR size, and safe Base64 image payload
      allow create: if isTenant()
                    && request.resource.data.tenantUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount > 0
                    && request.resource.data.utr is string
                    && request.resource.data.utr.size() >= 6
                    && request.resource.data.utr.size() <= 40
                    && request.resource.data.proofUrl is string
                    && request.resource.data.proofUrl.size() > 0
                    && request.resource.data.proofUrl.size() <= 600000
                    && request.resource.data.proofUrl.matches('^data:image/(jpeg|png|webp);base64,.*');
      // Strictly restrict approval, rejection, edits and deletion to verified administrators
      allow update, delete: if isAdmin();
    }

    // ─── Notifications Collection ───────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isTenant() && resource.data.tenantUid == request.auth.uid);
      allow create, delete: if isAdmin();
      // Tenant can mark their own notifications as read
      allow update: if (isTenant() && resource.data.tenantUid == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
                    || isAdmin();
    }

    // ─── Settings Collection ────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow create: if isAdmin() || (isAuthenticated() && isFirstTimeSetup()
                    && settingId == 'general'
                    && request.resource.data.bootstrapUid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow update, delete: if isAdmin();
    }

    function validMaintenanceStage(old, next) {
      return next == old
        || (old == 'submitted' && next == 'acknowledged')
        || (old == 'acknowledged' && next == 'assigned')
        || (old == 'assigned' && next == 'in_progress')
        || (old == 'in_progress' && next == 'resolved')
        || (old == 'resolved' && next == 'closed');
    }
    match /maintenance/{requestId} {
      allow read: if isAdmin() || (isTenant() && resource.data.tenantUid == request.auth.uid);
      allow create: if isTenant()
        && request.resource.data.keys().hasOnly(['tenantUid','roomId','propertyId','category','description','repairNeeded','priority','photoUrl','status','assignee','cost','createdAt','updatedAt'])
        && request.resource.data.tenantUid == request.auth.uid
        && get(/databases/$(database)/documents/tenancies/$(getUserData().tenancyId)).data.tenantUid == request.auth.uid
        && get(/databases/$(database)/documents/tenancies/$(getUserData().tenancyId)).data.active == true
        && request.resource.data.roomId == get(/databases/$(database)/documents/tenancies/$(getUserData().tenancyId)).data.roomId
        && request.resource.data.propertyId == get(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.propertyId
        && request.resource.data.category in ['plumbing','electrical','appliances','furniture','doors_windows','other']
        && request.resource.data.priority in ['low','normal','urgent']
        && request.resource.data.description is string && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 2000
        && request.resource.data.repairNeeded is string && request.resource.data.repairNeeded.size() >= 3 && request.resource.data.repairNeeded.size() <= 1000
        && request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 300000
        && (request.resource.data.photoUrl == '' || request.resource.data.photoUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.status == 'submitted' && request.resource.data.assignee == '' && request.resource.data.cost == 0
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','assignee','cost','updatedAt'])
        && validMaintenanceStage(resource.data.status, request.resource.data.status)
        && request.resource.data.assignee is string && request.resource.data.assignee.size() <= 100
        && (!(request.resource.data.status in ['assigned','in_progress','resolved','closed']) || request.resource.data.assignee.size() > 0)
        && request.resource.data.cost is int && request.resource.data.cost >= 0
        && request.resource.data.updatedAt == request.time;
    }

    // RentEase Connect: one immutable participant pair per tenancy.
    function chatOwner(leaseId) {
      let lease = get(/databases/$(database)/documents/tenancies/$(leaseId)).data;
      let room = get(/databases/$(database)/documents/rooms/$(lease.roomId)).data;
      let property = get(/databases/$(database)/documents/properties/$(room.propertyId)).data;
      return property.get('ownerUid', get(/databases/$(database)/documents/settings/general).data.get('bootstrapUid', ''));
    }
    function chatLease(leaseId, tenantUid, ownerUid) {
      let lease = get(/databases/$(database)/documents/tenancies/$(leaseId)).data;
      let tenant = get(/databases/$(database)/documents/users/$(tenantUid)).data;
      let owner = get(/databases/$(database)/documents/users/$(ownerUid)).data;
      return lease.active == true && lease.tenantUid == tenantUid
        && tenant.active == true && tenant.role == 'tenant' && tenant.tenancyId == leaseId
        && owner.active == true && owner.role == 'admin' && ownerUid == chatOwner(leaseId);
    }
    function chatParticipant(c) {
      return isAuthenticated() && getUserData().active == true
        && ((isTenant() && c.tenantUid == request.auth.uid) || (isAdmin() && c.ownerUid == request.auth.uid));
    }
    match /conversations/{conversationId} {
      // Permit a participant to check a deterministic, not-yet-created conversation.
      allow get: if (resource != null && chatParticipant(resource.data))
        || (resource == null && isAuthenticated()
          && (request.auth.uid == get(/databases/$(database)/documents/tenancies/$(conversationId)).data.tenantUid || request.auth.uid == chatOwner(conversationId))
          && getUserData().active == true);
      allow list: if chatParticipant(resource.data) && request.query.limit <= 100;
      allow create: if chatParticipant(request.resource.data)
        && request.resource.data.keys().hasOnly(['tenantUid','ownerUid','tenancyId','tenantName','seq','tenantSent','ownerSent','tenantRead','ownerRead','createdAt','updatedAt'])
        && request.resource.data.tenancyId == conversationId
        && chatLease(conversationId,request.resource.data.tenantUid,request.resource.data.ownerUid)
        && request.resource.data.tenantName == get(/databases/$(database)/documents/users/$(request.resource.data.tenantUid)).data.name
        && request.resource.data.seq == 0 && request.resource.data.tenantSent == 0 && request.resource.data.ownerSent == 0
        && request.resource.data.tenantRead == 0 && request.resource.data.ownerRead == 0
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if chatParticipant(resource.data) && (validChatRead() || validChatSend());
      function validChatRead() {
        let n = request.resource.data;
        let c = resource.data;
        return (request.auth.uid == c.tenantUid
          && n.diff(c).affectedKeys().hasOnly(['tenantRead'])
          && n.tenantRead is int && n.tenantRead >= c.tenantRead && n.tenantRead <= c.ownerSent)
        || (request.auth.uid == c.ownerUid
          && n.diff(c).affectedKeys().hasOnly(['ownerRead'])
          && n.ownerRead is int && n.ownerRead >= c.ownerRead && n.ownerRead <= c.tenantSent);
      }
      function validChatSend() {
        let n = request.resource.data;
        let c = resource.data;
        let m = getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(n.lastMessageId)).data;
        return chatLease(conversationId,c.tenantUid,c.ownerUid)
          && n.diff(c).affectedKeys().hasOnly(['seq','tenantSent','ownerSent','lastMessageId','updatedAt'])
          && n.seq == c.seq + 1 && n.updatedAt == request.time
          && !exists(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(n.lastMessageId))
          && m.seq == n.seq && m.senderUid == request.auth.uid && m.createdAt == request.time
          && ((request.auth.uid == c.tenantUid && n.tenantSent == c.tenantSent+1 && n.ownerSent == c.ownerSent && m.ordinal == n.tenantSent)
            || (request.auth.uid == c.ownerUid && n.ownerSent == c.ownerSent+1 && n.tenantSent == c.tenantSent && m.ordinal == n.ownerSent));
      }
      match /messages/{messageId} {
        function conversation() { return get(/databases/$(database)/documents/conversations/$(conversationId)).data; }
        allow get: if chatParticipant(conversation());
        allow list: if chatParticipant(conversation()) && request.query.limit <= 40;
        allow create: if chatParticipant(conversation()) && validMessage();
        function validMessage() {
          let c = conversation();
          let n = getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
          let m = request.resource.data;
          return chatLease(conversationId,c.tenantUid,c.ownerUid)
            && m.keys().hasOnly(['senderUid','text','seq','ordinal','maintenanceId','createdAt'])
            && m.senderUid == request.auth.uid && m.createdAt == request.time
            && m.text is string && m.text.size() > 0 && m.text.size() <= 2000 && m.text.matches('(?s).*[^\\s].*')
            && m.seq == c.seq+1 && n.seq == m.seq && n.lastMessageId == messageId
            && m.ordinal == (request.auth.uid == c.tenantUid ? n.tenantSent : n.ownerSent)
            && m.maintenanceId is string && m.maintenanceId.size() <= 128
            && (m.maintenanceId == '' || (
              get(/databases/$(database)/documents/maintenance/$(m.maintenanceId)).data.tenantUid == c.tenantUid
              && get(/databases/$(database)/documents/maintenance/$(m.maintenanceId)).data.roomId == get(/databases/$(database)/documents/tenancies/$(conversationId)).data.roomId));
        }
      }
    }

    // ─── Audit Logs Collection ──────────────────────────────────────
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}

